{
	"name": "backend",
	"scripts": {
		"dev": "bun run --hot src/server/index.ts",
		"start": "bun run dist/index.js",
		"lint": "bunx biome check --write",
		"compile": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/server/index.ts",
		"db:seed": "bun run src/database/seed.ts",
		"db:migrate": "bun run drizzle-kit migrate",
		"db:generate": "bun run drizzle-kit generate",
		"db:push": "bun run drizzle-kit push"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.992.0",
		"@aws-sdk/s3-request-presigner": "^3.992.0",
		"@hono/zod-openapi": "^1.2.2",
		"@scalar/hono-api-reference": "^0.9.44",
		"dotenv": "^17.3.1",
		"drizzle-cuid2": "^2.2.0",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.11.9",
		"hono-sessions": "^0.8.1",
		"pg": "^8.18.0",
		"resend": "^6.9.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@types/bun": "latest",
		"@types/node": "^25.3.0",
		"@types/pg": "^8.16.0",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0"
	}
}
